	import pytesseract
from PIL import Image, ImageEnhance, ImageFilter

# Configurar caminho do Tesseract (Windows)
pytesseract.pytesseract.tesseract_cmd = r"C:\Program Files\Tesseract-OCR\tesseract.exe"

# Abrir imagem e pré-processar
img = Image.open("imagem.png")
img = img.convert("L")  # Converter para escala de cinza
img = img.filter(ImageFilter.SHARPEN)  # Aumentar nitidez
enhancer = ImageEnhance.Contrast(img)
img = enhancer.enhance(2.0)  # Aumentar contraste

# Extrair texto
texto = pytesseract.image_to_string(img, lang="por")
print(texto)























































